{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ruff",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "ruff", "check", "src", "tests"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "mypy",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "mypy", "src", "tests"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "pytest",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "pytest", "-vv", "tests"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "check-all",
      "dependsOn": ["ruff", "mypy", "pytest"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
